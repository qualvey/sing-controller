{
  "extends": "@tsconfig/node22/tsconfig.json",

  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "noEmit": true,

    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "strict": true
  },
    "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*"
  ],
}
