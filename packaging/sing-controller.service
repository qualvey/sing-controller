[Unit]
Description=sing-box controller (WebUI & configuration management service)
Documentation=https://github.com/qualvey/sing-controller
After=network.target nss-lookup.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# 双服务架构下需要调用 systemctl reload/restart sing-box，故以 root 身份运行
User=root
Group=root

# 1. 采用 systemd 标准状态目录：自动创建 /var/lib/sing-box 并赋权，存放 cache.db 与运行时状态
StateDirectory=sing-box
WorkingDirectory=/var/lib/sing-box

# 2. 完整能力集：网络底层控制 + TUN 网卡 + 进程规则嗅探 (process_name)
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH

# 3. 资源限制与执行命令
LimitNOFILE=1048576
ExecStart=/usr/bin/sing-controller -config /etc/sing-controller/config.json
Restart=on-failure
RestartSec=5s

# 4. 写盘路径开放
# /etc/sing-controller: controller 自身配置；/etc/sing-box: 主配置（原子写盘 tmp+rename 需可写）
ReadWritePaths=/etc/sing-controller /etc/sing-box

[Install]
WantedBy=multi-user.target
