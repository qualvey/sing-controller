[Unit]
Description=sing-box controller (configuration management API)
Documentation=https://github.com/qualvey/sing-controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sing-controller
Group=sing-controller
# 允许非 root 绑定特权端口（<1024，如 listen 0.0.0.0:80）
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/sing-controller -config /etc/sing-controller/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/sing-controller

[Install]
WantedBy=multi-user.target
