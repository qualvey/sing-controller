[Unit]
Description=sing-box controller (configuration management API)
Documentation=https://github.com/qualvey/sing-controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sing-controller
Group=sing-controller
ExecStart=/usr/bin/sing-controller -config /etc/sing-controller/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/sing-controller

[Install]
WantedBy=multi-user.target
