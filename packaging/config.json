{
  "server": {
    "listen": "::",
    "listen_port": 8080
  },
  "log": {
    "level": "info",
    "output": "stderr"
  },
  "core": {
    "config_path": "/etc/sing-box/config.json",
    "managed": false,
    "reload": {
      "mode": "auto",
      "service": "sing-box",
      "after_save": false
    }
  },
  "api": {
    "clash": {
      "address": ""
    },
    "service": {
      "address": ""
    },
    "v2ray": {
      "address": "127.0.0.1:10085"
    }
  },
  "stats": {
    "poll_interval": "10s",
    "real_time": {
      "enabled": false,
      "interval_ms": 1000,
      "online_threshold_sec": 60
    }
  },
  "database": {
    "dsn": ""
  },
  "node_probe": {
    "enabled": true,
    "interval": "120s",
    "test_url": "https://www.gstatic.com/generate_204",
    "timeout": "10s",
    "history_retention_days": 30,
    "webhooks": []
  }
}
