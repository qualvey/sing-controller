{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "agent-browser": {
        "type": "local",
        "command": ["agent-browser", "mcp", "--tools", "all"]
      }
    }
  }
}
