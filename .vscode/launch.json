{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "全栈开发（F5）",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/controller",
      "cwd": "${workspaceFolder}",
      "args": [
        "-config",
        "${workspaceFolder}/.vscode/controller.dev.json"
      ],
      "buildFlags": "-tags=with_quic,with_tailscale,with_gvisor,with_utls,with_clash_api,with_acme,with_tun,with_dhcp,with_wireguard,with_ccm,with_ocm,with_cloudflared,with_usbip",
      "preLaunchTask": "前端：启动 Vite",
      "env": {
        "CGO_ENABLED": "0"
      }
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "前端浏览器（5173）",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/controller/web",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "vite:///*": "${workspaceFolder}/*",
        "/controller/web/*": "${workspaceFolder}/controller/web/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "全栈开发（前端 + Controller + sing-box）",
      "configurations": [
        "全栈开发（F5）",
        "前端浏览器（5173）"
      ],
      "stopAll": true
    }
  ]
}
