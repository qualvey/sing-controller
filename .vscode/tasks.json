{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "前端：启动 Vite",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/controller/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "(Local|ready in|5173)"
        }
      },
      "presentation": {
        "group": "全栈开发",
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
